{
  "name": "extended-ts-types",
  "version": "0.1.0",
  "description": "Extended utility types and type guards for TypeScript",
  "keywords": [
    "typescript",
    "types",
    "type-guards",
    "utility-types",
    "typeguard"
  ],
  "license": "MIT",
  "author": "Nazil Rakhimov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nile-outcast/extended-ts-types.git"
  },
  "bugs": {
    "url": "https://github.com/nile-outcast/extended-ts-types/issues"
  },
  "homepage": "https://github.com/nile-outcast/extended-ts-types#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "publint && attw --pack . --profile node16",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:package"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
